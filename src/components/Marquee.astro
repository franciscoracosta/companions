---
import type { Locale } from '../config';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const d = t(Astro.props.locale);
const items = [...d.marquee, ...d.marquee];
---

<div class="marquee" aria-hidden="true">
  <div class="track">
    {items.map((m) => (
      <span class="item">
        {m}
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" /></svg>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
    padding-block: 22px;
    transform: rotate(-1.5deg);
    margin-inline: -20px;
  }

  .track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  svg {
    fill: var(--sun);
  }
</style>
