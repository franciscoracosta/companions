---
import type { Locale } from '../config';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const d = t(Astro.props.locale);
---

<section class="section" id="roadmap">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{d.roadmap.eyebrow}</span>
      <h2 class="h2">{d.roadmap.title}</h2>
    </div>

    <ol class="steps" data-roadmap>
      <span class="track" aria-hidden="true"><span class="fill" data-roadmap-fill></span></span>
      {d.roadmap.steps.map((s) => (
        <li class:list={['step', { done: s.done }]} data-reveal>
          <span class="node" aria-hidden="true">
            {s.done && <svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>}
          </span>
          <span class="date">{s.date}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .track {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    height: 4px;
    border-radius: 4px;
    background: var(--line);
    overflow: hidden;
  }

  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--mint), var(--sun), var(--coral));
    transform-origin: left;
    transform: scaleX(0.4);
  }

  .step {
    position: relative;
    padding-top: 52px;
  }

  .node {
    position: absolute;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: inset 0 0 0 3px var(--line);
    display: grid;
    place-items: center;
  }

  .done .node {
    background: var(--mint);
    box-shadow: 0 0 0 6px rgba(47, 197, 154, 0.18);
  }

  .date {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .done .date {
    color: var(--mint);
  }

  h3 {
    font-size: 24px;
    margin-top: 8px;
  }

  p {
    margin-top: 8px;
    color: var(--ink-2);
    font-size: 16px;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .track {
      left: 14px;
      right: auto;
      top: 14px;
      bottom: 14px;
      width: 4px;
      height: auto;
    }

    .fill {
      transform-origin: top;
      transform: scaleY(0.4);
    }

    .step {
      padding-top: 0;
      padding-left: 56px;
    }
  }
</style>
