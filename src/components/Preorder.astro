---
import Robot from './Robot.astro';
import { lines, localeMeta, type LineId, type Locale } from '../config';
import { formatPrice, href, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const lang = localeMeta[locale].htmlLang;
const order: LineId[] = ['care', 'guard', 'play'];
---

<section class="section" id="preorder">
  <div class="wrap">
    <div class="box" data-reveal>
      <div class="copy">
        <span class="eyebrow">{d.preorder.eyebrow}</span>
        <h2 class="h2">{d.preorder.title}</h2>
        <p class="lead">{d.preorder.subtitle}</p>
        <ul class="perks">
          {d.preorder.perks.map((p) => (
            <li>
              <span class="star" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" /></svg></span>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <form class="form" data-preorder novalidate>
        <fieldset>
          <legend class="sr-only">{d.lines.title}</legend>
          {order.map((id, i) => {
            const item = d.lines.items[id];
            const meta = lines[id];
            return (
              <label class="opt" style={`--accent:${meta.color};--soft:${meta.soft}`}>
                <input type="radio" name="model" value={id} checked={i === 0} />
                <span class="opt-bot"><Robot variant={id} /></span>
                <span class="opt-text">
                  <strong>{item.name}</strong>
                  <small>{item.tagline}</small>
                </span>
                <span class="opt-price">
                  <strong>{formatPrice(meta.price, lang)}</strong>
                  <small>{d.preorder.deposit} {formatPrice(meta.deposit, lang)}</small>
                </span>
              </label>
            );
          })}
        </fieldset>

        <label class="field">
          <span>{d.preorder.emailLabel}</span>
          <input type="email" name="email" required autocomplete="email" placeholder={d.preorder.emailPlaceholder} />
        </label>

        <button type="submit" class="btn btn--coral submit">
          {d.preorder.button}
          <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>

        <p class="consent">
          {d.preorder.consent} <a href={href(locale, 'privacy')}>{d.preorder.consentLink}</a>.
        </p>

        <p class="success" role="status" aria-live="polite" data-success hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {d.preorder.success}
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(18px, 5vw, 64px);
    border-radius: clamp(28px, 4vw, 48px);
    background: linear-gradient(140deg, var(--coral-soft), var(--sun-soft) 60%, var(--sky-soft));
    position: relative;
    overflow: hidden;
  }

  .perks {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 14px;
    font-weight: 600;
  }

  .perks li {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .star {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ink);
  }

  .star svg {
    fill: var(--sun);
  }

  .form {
    background: var(--paper);
    border-radius: var(--radius);
    padding: clamp(14px, 3vw, 32px);
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: 16px;
    align-self: center;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .opt {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 10px 16px 10px 10px;
    border-radius: 20px;
    box-shadow: inset 0 0 0 1.5px var(--line);
    cursor: pointer;
    transition: box-shadow 0.3s, background 0.3s, transform 0.3s var(--ease);
  }

  .opt:hover {
    transform: translateY(-1px);
  }

  .opt input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .opt:has(input:checked) {
    background: var(--soft);
    box-shadow: inset 0 0 0 2px var(--accent);
  }

  .opt:has(input:focus-visible) {
    outline: 3px solid var(--sky);
    outline-offset: 2px;
  }

  .opt-bot {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--soft);
  }

  .opt-bot :global(.robot) {
    width: 40px;
  }

  .opt:not(:has(input:checked)) .opt-bot :global(*) {
    animation-play-state: paused;
  }

  .opt-text,
  .opt-price {
    display: grid;
    line-height: 1.3;
  }

  .opt-price {
    text-align: right;
  }

  .opt small {
    font-size: 13px;
    color: var(--ink-3);
  }

  .field {
    display: grid;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    margin-top: 6px;
  }

  .field input {
    height: 54px;
    padding: 0 18px;
    border-radius: 16px;
    border: 0;
    box-shadow: inset 0 0 0 1.5px var(--line);
    font: 400 16px var(--font-body);
    color: var(--ink);
    background: var(--cream);
    transition: box-shadow 0.25s;
  }

  .field input:focus {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .field input[aria-invalid='true'] {
    box-shadow: inset 0 0 0 2px var(--coral);
  }

  .submit {
    width: 100%;
    min-height: 56px;
    font-size: 17px;
  }

  .consent {
    font-size: 13px;
    color: var(--ink-3);
    text-align: center;
  }

  .success {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(47, 197, 154, 0.12);
    color: #137a5c;
    font-weight: 600;
    font-size: 15px;
  }

  .success[hidden] {
    display: none;
  }

  @media (max-width: 960px) {
    .box {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 420px) {
    .opt {
      grid-template-columns: 48px 1fr auto;
      gap: 10px;
    }

    .opt-bot {
      width: 48px;
      height: 48px;
    }
  }
</style>
