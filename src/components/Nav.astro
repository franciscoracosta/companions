---
import Logo from './Logo.astro';
import { locales, localeMeta, type Locale, type SitePage } from '../config';
import { href, t } from '../i18n';

interface Props {
  locale: Locale;
  page?: SitePage;
}

const { locale, page } = Astro.props;
const d = t(locale);
const links = [
  { id: 'robots', label: d.nav.lines },
  { id: 'flight', label: d.nav.flight },
  { id: 'how', label: d.nav.how },
  { id: 'roadmap', label: d.nav.roadmap },
  { id: 'faq', label: d.nav.faq },
];
---

<header class="nav" data-nav>
  <div class="nav-inner">
    <a href={href(locale)} class="nav-logo" aria-label="Home"><Logo /></a>

    <nav class="nav-links" aria-label="Main">
      {links.map((l) => <a href={href(locale, undefined, l.id)}>{l.label}</a>)}
    </nav>

    <div class="nav-actions">
      <details class="lang" data-lang>
        <summary aria-label={d.nav.language}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span>{localeMeta[locale].short}</span>
        </summary>
        <ul>
          {locales.map((l) => (
            <li>
              <a href={href(l, page)} hreflang={localeMeta[l].htmlLang} lang={localeMeta[l].htmlLang} aria-current={l === locale ? 'true' : undefined} data-set-locale={l}>
                <span class="lang-code">{localeMeta[l].short}</span>{localeMeta[l].label}
              </a>
            </li>
          ))}
        </ul>
      </details>
      <a href={href(locale, undefined, 'preorder')} class="btn btn--coral btn--sm">{d.nav.cta}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 12px 0 auto;
    z-index: 50;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  .nav-inner {
    pointer-events: auto;
    max-width: var(--wrap);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 10px 10px 18px;
    border-radius: 999px;
    background: rgba(255, 248, 238, 0.72);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid transparent;
    transition: border-color 0.4s, box-shadow 0.4s, background 0.4s;
  }

  :global(.nav.is-scrolled) .nav-inner {
    border-color: var(--line);
    box-shadow: var(--shadow);
    background: rgba(255, 255, 255, 0.85);
  }

  .nav-logo {
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    transition: background 0.25s, color 0.25s;
  }

  .nav-links a:hover {
    background: rgba(27, 26, 46, 0.06);
    color: var(--ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    position: relative;
  }

  .lang summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 42px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    color: var(--ink-2);
  }

  .lang summary svg {
    flex: none;
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover,
  .lang[open] summary {
    background: rgba(27, 26, 46, 0.06);
    color: var(--ink);
  }

  .lang ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    min-width: 220px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--paper);
    border-radius: 20px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
  }

  .lang a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 15px;
    text-decoration: none;
  }

  .lang a:hover {
    background: var(--cream);
  }

  .lang a[aria-current] {
    background: var(--coral-soft);
  }

  .lang-code {
    font-size: 11px;
    font-weight: 700;
    width: 28px;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .nav-inner {
      padding-left: 14px;
    }

    .nav-logo :global(.logo-word) {
      font-size: 24px;
    }
  }
</style>
