---
import type { Locale } from '../config';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const d = t(Astro.props.locale);
---

<section class="section faq" id="faq">
  <div class="wrap faq-grid">
    <div data-reveal>
      <span class="eyebrow">FAQ</span>
      <h2 class="h2">{d.faq.title}</h2>
    </div>
    <div class="list">
      {d.faq.items.map((it) => (
        <details data-reveal>
          <summary>
            {it.q}
            <span class="plus" aria-hidden="true" />
          </summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-top: 0;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 48px;
    align-items: start;
  }

  .list {
    display: grid;
    gap: 12px;
  }

  details {
    background: var(--paper);
    border-radius: 22px;
    box-shadow: var(--shadow);
    padding: 4px 24px;
  }

  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .plus {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--cream);
    transition: background 0.3s, transform 0.4s var(--ease);
  }

  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.4s var(--ease);
  }

  .plus::after {
    transform: rotate(90deg);
  }

  details[open] .plus {
    background: var(--coral);
    transform: rotate(180deg);
  }

  details[open] .plus::before,
  details[open] .plus::after {
    background: #fff;
  }

  details[open] .plus::after {
    transform: rotate(0deg);
  }

  details p {
    padding-bottom: 20px;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
