---
import type { LineId } from '../config';

interface Props {
  variant: LineId;
  class?: string;
  blueprint?: boolean;
  /** Show the flight rotors deployed (drone mode) */
  flying?: boolean;
  label?: string;
}

const { variant, class: cls = '', blueprint = false, flying = false, label } = Astro.props;
const id = `${variant}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg
  class:list={['robot', `robot--${variant}`, { 'robot--blueprint': blueprint, 'robot--flying': flying }, cls]}
  viewBox="0 0 200 250"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-robot
>
  <defs>
    <linearGradient id={`shell-${id}`} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="var(--r-light)" />
      <stop offset="1" stop-color="var(--r-main)" />
    </linearGradient>
  </defs>

  <ellipse class="r-shadow" cx="100" cy="240" rx="54" ry="6" />

  {/* Feet hide the wheels, so they stay on the ground while the body sways */}
  <g class="r-legs">
    <g class="r-leg r-leg--l">
      <path d="M62 232c0-9 8-14 18-14s18 5 18 14z" class="r-foot" />
      <path d="M68 232v-4M80 232v-5M92 232v-4" class="r-toe" />
    </g>
    <g class="r-leg r-leg--r">
      <path d="M102 232c0-9 8-14 18-14s18 5 18 14z" class="r-foot" />
      <path d="M108 232v-4M120 232v-5M132 232v-4" class="r-toe" />
    </g>
  </g>

  <g class="r-body">
    {/* Flight rotors (drone mode): four arms slide out of the middle of the body. Back pair first, behind the wings */}
    <g class="r-rotors r-rotors--back">
      <g class="r-rotor">
          <path d="M70 160 18 150" class="r-boom" />
          <ellipse cx="16" cy="146" rx="24" ry="6" class="r-guard" />
          <ellipse cx="16" cy="146" rx="21" ry="4" class="r-disc" />
          <ellipse cx="16" cy="146" rx="20" ry="2.4" class="r-prop" />
          <rect x="11" y="146" width="10" height="9" rx="3" class="r-motor" />
        </g>
      <g class="r-rotor">
          <path d="M130 160l52-10" class="r-boom" />
          <ellipse cx="184" cy="146" rx="24" ry="6" class="r-guard" />
          <ellipse cx="184" cy="146" rx="21" ry="4" class="r-disc" />
          <ellipse cx="184" cy="146" rx="20" ry="2.4" class="r-prop" />
          <rect x="179" y="146" width="10" height="9" rx="3" class="r-motor" />
        </g>
    </g>

    {/* Wings */}
    <path class="r-arm r-arm--l" d="M52 148c-16 14-20 38-10 58 4-4 9-10 12-17 3-12 2-28-2-41z" />
    <path class="r-arm r-arm--r" d="M148 148c16 14 20 38 10 58-4-4-9-10-12-17-3-12-2-28 2-41z" />

    {/* Torso */}
    <path d="M100 128c-40 0-50 34-50 58 0 26 22 36 50 36s50-10 50-36c0-24-10-58-50-58z" class="r-shell" fill={blueprint ? 'none' : `url(#shell-${id})`} />
    <path d="M100 148c-20 0-30 20-30 38 0 18 14 28 30 28s30-10 30-28c0-18-10-38-30-38z" class="r-belly" />
    <path d="M84 166q4 5 8 0q4 5 8 0q4 5 8 0q4 5 8 0M80 179q4 5 8 0q4 5 8 0q4 5 8 0q4 5 8 0q4 5 8 0" class="r-feather" />
    <g class="r-emblem" transform="translate(100 199)">
      {variant === 'care' && <path d="M0 -5c-3-6-12-5-12 2 0 6 7 9 12 13 5-4 12-7 12-13 0-7-9-8-12-2z" />}
      {variant === 'guard' && <path d="M0 -11l11 4v6c0 8-5 12-11 15-6-3-11-7-11-15v-6z" />}
      {variant === 'play' && <path d="M0 -11l3.3 6.9 7.4 1-5.5 5.1 1.4 7.4-6.6-3.7-6.6 3.7 1.4-7.4-5.5-5.1 7.4-1z" />}
    </g>

    {/* Waist seam the rotor arms slide out of, then the front pair */}
    <path d="M52 176c30 6 66 6 96 0" class="r-seam" />
    <g class="r-rotors r-rotors--front">
      <g class="r-rotor">
          <path d="M60 176-12 166" class="r-boom" />
          <ellipse cx="-12" cy="160" rx="32" ry="8" class="r-guard" />
          <ellipse cx="-12" cy="160" rx="29" ry="6" class="r-disc" />
          <ellipse cx="-12" cy="160" rx="28" ry="2.4" class="r-prop" />
          <rect x="-17" y="160" width="10" height="9" rx="3" class="r-motor" />
        </g>
      <g class="r-rotor">
          <path d="M140 176l72-10" class="r-boom" />
          <ellipse cx="212" cy="160" rx="32" ry="8" class="r-guard" />
          <ellipse cx="212" cy="160" rx="29" ry="6" class="r-disc" />
          <ellipse cx="212" cy="160" rx="28" ry="2.4" class="r-prop" />
          <rect x="207" y="160" width="10" height="9" rx="3" class="r-motor" />
        </g>
    </g>

    {/* Neck joint: the head turns on it like an owl's */}
    <rect x="80" y="124" width="40" height="14" rx="7" class="r-limb" />

    <g class="r-head">
      {/* Ears, one style per line */}
      {variant === 'care' && (
        <g class="r-ears">
          <circle cx="44" cy="40" r="19" class="r-ear r-ear--l" />
          <circle cx="156" cy="40" r="19" class="r-ear r-ear--r" />
          <circle cx="44" cy="40" r="9" class="r-tip" />
          <circle cx="156" cy="40" r="9" class="r-tip" />
        </g>
      )}
      {variant === 'guard' && (
        <g class="r-ears">
          <path d="M36 62 30 4l46 34z" class="r-ear r-ear--l" />
          <path d="M164 62l6-58-46 34z" class="r-ear r-ear--r" />
          <path d="M43 46 40 18l22 18zM157 46l3-28-22 18z" class="r-tip" />
        </g>
      )}
      {variant === 'play' && (
        <g class="r-ears">
          <g class="r-antenna r-antenna--l">
            <path d="M66 36C48 18 40-2 56-6" class="r-spring" />
            <circle cx="56" cy="-6" r="9" class="r-tip" />
          </g>
          <g class="r-antenna r-antenna--r">
            <path d="M134 36c18-18 26-38 10-42" class="r-spring" />
            <circle cx="144" cy="-6" r="9" class="r-tip r-tip--alt" />
          </g>
        </g>
      )}

      <rect x="24" y="24" width="152" height="112" rx="54" class="r-shell" fill={blueprint ? 'none' : `url(#shell-${id})`} />
      <ellipse cx="62" cy="40" rx="18" ry="7" class="r-shine" transform="rotate(-20 62 40)" />

      {/* Facial disc and eye screens */}
      <path d="M100 58c-8-8-20-12-30-12-20 0-36 16-36 36s16 36 36 36c12 0 24-6 30-14 6 8 18 14 30 14 20 0 36-16 36-36s-16-36-36-36c-10 0-22 4-30 12z" class="r-screen" />
      <circle cx="70" cy="82" r="25" class="r-socket" />
      <circle cx="130" cy="82" r="25" class="r-socket" />
      <g class="r-eyes">
        <g class="r-eye">
          <circle cx="70" cy="82" r="16" class="r-iris" />
          <circle cx="71" cy="83" r="8" class="r-pupil" />
          <circle cx="65" cy="76" r="3.4" class="r-glint" />
        </g>
        <g class="r-eye">
          <circle cx="130" cy="82" r="16" class="r-iris" />
          <circle cx="131" cy="83" r="8" class="r-pupil" />
          <circle cx="125" cy="76" r="3.4" class="r-glint" />
        </g>
      </g>
      <path d="M100 100l-8 9 8 13 8-13z" class="r-beak" />
      <circle cx="51" cy="105" r="5.5" class="r-cheek" />
      <circle cx="149" cy="105" r="5.5" class="r-cheek" />
    </g>
  </g>
</svg>
