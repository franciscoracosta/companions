---
import Base from '../../layouts/Base.astro';
import Robot from '../../components/Robot.astro';
import { brand, locales, type LineId, type Locale } from '../../config';
import { href, t, tInvestors } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const site = t(locale);
const { d, lang } = tInvestors(locale);
const mail = `mailto:${brand.email}?subject=${encodeURIComponent(d.cta.subject)}`;
const robots: LineId[] = ['care', 'guard', 'play'];
const barColors = ['var(--coral)', 'var(--sky)', 'var(--sun)', 'var(--mint)'];
const problemIcons = [
  'M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11zM9 10h6',
  'M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6zM9 12l2 2 4-4',
  'M4 6h16v10H4zM8 20h8M12 16v4',
];
const advantageIcons = [
  'M9 3h6M9 21h6M3 9v6M21 9v6M7 7h10v10H7zM10 10h4v4h-4z',
  'M12 2l9 5v10l-9 5-9-5V7zM12 22V12M21 7l-9 5-9-5',
  'M12 21C6 16.5 3 13 3 9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 9 2.5C21 13 18 16.5 12 21z',
  'M4 20l4-4M14 4l6 6-9 9H5v-6z',
];
---

<Base locale={locale} page="investors" title={d.meta.title} description={d.meta.description}>
  <div lang={lang}>
    <section class="inv-hero">
      <div class="wrap hero-grid">
        <div>
          <span class="badge" data-hero><span class="dot"></span>{d.hero.badge}</span>
          <h1 data-hero>{d.hero.title}</h1>
          <p class="sub" data-hero>{d.hero.subtitle}</p>
          <div class="ctas" data-hero>
            <a href={mail} class="btn btn--coral">
              {d.hero.cta}
              <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <a href={href(locale)} class="btn btn--ghost">{d.hero.secondary}</a>
          </div>
        </div>
        <div class="hero-bots" aria-hidden="true">
          {robots.map((r) => (
            <div class:list={['hbot', `hbot--${r}`]} data-bot><Robot variant={r} /></div>
          ))}
          <span class="platform"></span>
        </div>
      </div>
    </section>

    <section class="section" id="problem">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{d.problem.eyebrow}</span>
          <h2 class="h2 wide">{d.problem.title}</h2>
        </div>
        <div class="cards3">
          {d.problem.items.map((it, i) => (
            <article class="card" data-reveal>
              <span class="icon"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={problemIcons[i]} /></svg></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </article>
          ))}
        </div>
        <div class="stats">
          {d.stats.map((s) => (
            <div class="stat" data-reveal>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
              {s.href ? <a href={s.href} target="_blank" rel="noopener">{s.source} ↗</a> : <em>{s.source}</em>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section dark" id="solution">
      <div class="wrap">
        <div class="section-head center" data-reveal>
          <span class="eyebrow">{d.solution.eyebrow}</span>
          <h2 class="h2">{d.solution.title}</h2>
          <p class="lead">{d.solution.subtitle}</p>
        </div>
        <div class="platform-row" data-reveal>
          {robots.map((r) => (
            <div class="pbot">
              <Robot variant={r} />
              <span>{site.lines.items[r].name}</span>
              <small>{site.lines.items[r].tagline}</small>
            </div>
          ))}
        </div>
        <div class="core" data-reveal aria-hidden="true">
          {d.solution.layers.map((l) => <span>{l}</span>)}
        </div>
      </div>
    </section>

    <section class="section" id="advantages">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{d.advantages.eyebrow}</span>
          <h2 class="h2">{d.advantages.title}</h2>
        </div>
        <div class="cards4">
          {d.advantages.items.map((it, i) => (
            <article class="card" data-reveal>
              <span class="icon icon--sky"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={advantageIcons[i]} /></svg></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section tinted" id="model">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{d.model.eyebrow}</span>
          <h2 class="h2 wide">{d.model.title}</h2>
        </div>
        <ol class="model">
          {d.model.items.map((it, i) => (
            <li data-reveal>
              <span class="num">0{i + 1}</span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="plan">
      <div class="wrap split">
        <div>
          <div class="section-head" data-reveal>
            <span class="eyebrow">{d.roadmap.eyebrow}</span>
            <h2 class="h2">{d.roadmap.title}</h2>
          </div>
          <ol class="timeline">
            {d.roadmap.steps.map((s, i) => (
              <li class:list={{ now: i === 0 }} data-reveal>
                <span class="date">{s.date}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
        <div class="funds" data-reveal>
          <span class="eyebrow">{d.funds.eyebrow}</span>
          <h3 class="funds-title">{d.funds.title}</h3>
          <ul>
            {d.funds.items.map((f, i) => (
              <li>
                <div class="frow"><span>{f.label}</span><strong>{f.value}%</strong></div>
                <span class="bar"><span data-bar style={`--w:${f.value}%; --c:${barColors[i]}`}></span></span>
              </li>
            ))}
          </ul>
          <p class="note">{d.funds.note}</p>
        </div>
      </div>
    </section>

    <section class="section team" id="team">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">{d.team.eyebrow}</span>
          <h2 class="h2">{d.team.title}</h2>
        </div>
        <div class="team-grid">
          <article class="card person" data-reveal>
            <span class="avatar" aria-hidden="true">F</span>
            <div>
              <h3>Francisco</h3>
              <span class="role">{d.team.founder}</span>
              <p>{d.team.founderText}</p>
            </div>
          </article>
          <article class="card hiring" data-reveal>
            <span class="avatar avatar--empty" aria-hidden="true">+</span>
            <p>{d.team.hiring}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="contact">
      <div class="wrap">
        <div class="cta" data-reveal>
          <div class="cta-bot" aria-hidden="true"><Robot variant="care" /></div>
          <h2>{d.cta.title}</h2>
          <p>{d.cta.text}</p>
          <a href={mail} class="btn btn--coral">
            {d.cta.button}
            <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <span class="mail">{brand.email}</span>
        </div>
        <p class="disclaimer">{d.disclaimer}</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .inv-hero {
    padding-block: 150px 60px;
    position: relative;
    overflow: hidden;
  }

  .inv-hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60vw;
    height: 60vw;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(61, 139, 255, 0.16), transparent 65%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 48px;
    align-items: center;
    position: relative;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 12px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: var(--shadow);
    font-size: 14px;
    font-weight: 600;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 0 4px var(--sky-soft);
  }

  h1 {
    font-size: clamp(42px, 6.4vw, 84px);
    margin-top: 24px;
    max-width: 13ch;
  }

  .sub {
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-2);
    max-width: 52ch;
    margin-top: 24px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-bots {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    gap: 4%;
    padding-bottom: 28px;
  }

  .hbot--guard {
    transform: translateY(-18%);
  }

  .platform {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: 0;
    height: 28px;
    border-radius: 999px;
    background: var(--ink);
    box-shadow: var(--shadow-lg);
  }

  .platform::after {
    content: '';
    position: absolute;
    inset: 10px 18% auto;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--coral), var(--sky), var(--sun));
  }

  .wide {
    max-width: 22ch;
  }

  .cards3,
  .cards4 {
    display: grid;
    gap: 20px;
  }

  .cards3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .cards4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .card {
    background: var(--paper);
    border-radius: var(--radius);
    padding: 32px;
    box-shadow: var(--shadow);
  }

  .card h3 {
    font-size: 24px;
    margin-top: 18px;
  }

  .card p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 16px;
    background: var(--coral-soft);
    color: var(--coral);
  }

  .icon--sky {
    background: var(--sky-soft);
    color: var(--sky);
  }

  .icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .stat {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 28px 32px;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1.5px var(--line);
  }

  .stat strong {
    font-family: var(--font-display);
    font-size: clamp(44px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--coral);
  }

  .stat span {
    color: var(--ink-2);
  }

  .stat a,
  .stat em {
    font-size: 13px;
    font-style: normal;
    font-weight: 600;
    color: var(--ink-3);
    text-decoration: none;
  }

  .stat a:hover {
    color: var(--sky);
  }

  .dark {
    background: var(--ink);
    color: var(--cream);
    border-radius: clamp(28px, 5vw, 56px);
    margin-inline: clamp(8px, 1.5vw, 20px);
    overflow: hidden;
  }

  .dark::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(124, 243, 230, 0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(124, 243, 230, 0.06) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at center, #000 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .dark .eyebrow {
    color: var(--eye);
  }

  .dark .lead {
    color: rgba(255, 248, 238, 0.7);
  }

  .center {
    text-align: center;
  }

  .center .h2,
  .center .lead {
    margin-inline: auto;
  }

  .platform-row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 820px;
    margin-inline: auto;
  }

  .pbot {
    display: grid;
    justify-items: center;
    gap: 4px;
    text-align: center;
  }

  .pbot :global(.robot) {
    width: min(180px, 100%);
    margin-bottom: 12px;
  }

  .pbot span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .pbot small {
    color: rgba(255, 248, 238, 0.6);
    font-size: 14px;
  }

  .core {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 820px;
    margin: 40px auto 0;
    padding: 18px;
    border-radius: 999px;
    background: rgba(124, 243, 230, 0.08);
    box-shadow: inset 0 0 0 1px rgba(124, 243, 230, 0.25);
  }

  .core span {
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(255, 248, 238, 0.08);
    font-size: 14px;
    font-weight: 600;
    color: var(--eye);
  }

  .tinted {
    background: var(--cream-2);
  }

  .model {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .model li {
    padding: 32px;
    border-radius: var(--radius);
    background: var(--paper);
  }

  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    color: var(--coral);
  }

  .model h3 {
    font-size: 26px;
    margin-top: 40px;
  }

  .model p {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
    border-left: 3px solid var(--line);
    padding-left: 28px;
  }

  .timeline li {
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -38px;
    top: 4px;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: inset 0 0 0 3px var(--line);
  }

  .timeline li.now::before {
    background: var(--mint);
    box-shadow: 0 0 0 6px rgba(47, 197, 154, 0.18);
  }

  .date {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .now .date {
    color: var(--mint);
  }

  .timeline h3 {
    font-size: 22px;
    margin-top: 6px;
  }

  .timeline p {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 16px;
  }

  .funds {
    position: sticky;
    top: 110px;
    padding: 36px;
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow-lg);
  }

  .funds-title {
    font-size: clamp(28px, 3vw, 36px);
    margin-top: 12px;
  }

  .funds ul {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  .frow {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 15px;
  }

  .frow strong {
    font-family: var(--font-display);
    font-size: 18px;
  }

  .bar {
    display: block;
    height: 10px;
    margin-top: 8px;
    border-radius: 10px;
    background: var(--cream-2);
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: 10px;
    background: var(--c);
    transform-origin: left;
  }

  .note {
    margin-top: 24px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
  }

  .person {
    display: flex;
    gap: 24px;
    align-items: flex-start;
  }

  .person h3 {
    margin-top: 0;
  }

  .role {
    display: inline-block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--coral);
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 24px;
    background: linear-gradient(135deg, var(--coral), var(--sun));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
  }

  .avatar--empty {
    background: transparent;
    color: var(--ink-3);
    box-shadow: inset 0 0 0 2px var(--line);
    font-size: 32px;
    font-weight: 500;
  }

  .hiring {
    display: flex;
    gap: 24px;
    align-items: center;
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--line);
  }

  .hiring p {
    margin-top: 0;
  }

  .cta {
    position: relative;
    text-align: center;
    padding: clamp(56px, 8vw, 96px) clamp(24px, 5vw, 64px);
    border-radius: clamp(28px, 5vw, 56px);
    background: linear-gradient(135deg, var(--coral-soft), var(--sun-soft) 55%, var(--sky-soft));
    overflow: hidden;
  }

  .cta-bot {
    width: 120px;
    margin: 0 auto 20px;
  }

  .cta h2 {
    font-size: clamp(40px, 6vw, 72px);
  }

  .cta p {
    max-width: 52ch;
    margin: 18px auto 32px;
    color: var(--ink-2);
    font-size: 18px;
  }

  .mail {
    display: block;
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-3);
  }

  .disclaimer {
    max-width: 70ch;
    margin: 28px auto 0;
    text-align: center;
    font-size: 13px;
    color: var(--ink-3);
  }

  @media (max-width: 1000px) {
    .cards4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .hero-grid,
    .split,
    .team-grid {
      grid-template-columns: 1fr;
    }

    .hero-bots {
      max-width: 420px;
    }

    .cards3,
    .stats,
    .model {
      grid-template-columns: 1fr;
    }

    .funds {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .cards4 {
      grid-template-columns: 1fr;
    }

    .platform-row {
      gap: 12px;
    }

    .pbot span {
      font-size: 16px;
    }

    .pbot small {
      font-size: 12px;
    }

    .person,
    .hiring {
      flex-direction: column;
    }

    .card,
    .funds {
      padding: 26px;
    }
  }
</style>
