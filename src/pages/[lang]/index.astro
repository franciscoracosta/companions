---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import Lines from '../../components/Lines.astro';
import Flight from '../../components/Flight.astro';
import Showcase from '../../components/Showcase.astro';
import How from '../../components/How.astro';
import Roadmap from '../../components/Roadmap.astro';
import Preorder from '../../components/Preorder.astro';
import Faq from '../../components/Faq.astro';
import { locales, type Locale } from '../../config';
import { t } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base locale={locale} title={d.meta.title} description={d.meta.description}>
  <Hero locale={locale} />
  <Marquee locale={locale} />
  <Lines locale={locale} />
  <Flight locale={locale} />
  <Showcase locale={locale} />
  <How locale={locale} />
  <Roadmap locale={locale} />
  <Preorder locale={locale} />
  <Faq locale={locale} />
</Base>
